{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,

    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,

    "allowSyntheticDefaultImports": true,

    "target": "ES2021",

    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src",

    "baseUrl": "./",

    "incremental": true,

    "skipLibCheck": true,

    "strict": false,

    "moduleResolution": "node"
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "test",
    "**/*.spec.ts"
  ]
}